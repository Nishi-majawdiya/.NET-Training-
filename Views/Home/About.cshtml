@{
    ViewBag.Title = "About";
}
<main aria-labelledby="title">
    @{
        ViewBag.Title = "Ticket Booking";
    }

    <div class="container mt-5">
        <h2 class="text-center mb-4">Ticket Booking Services</h2>

        <div class="row">


            <div class="col-md-4 mb-4">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h3>🚌 Bus Ticket</h3>
                        <p class="mt-3">
                            Book affordable and comfortable bus tickets across multiple cities.
                            Choose your seat and travel safely.
                        </p>
                        <a href="#" class="btn btn-primary mt-3">Book Bus Ticket</a>
                    </div>
                </div>
            </div>


            <div class="col-md-4 mb-4">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h3>🚆 Train Ticket</h3>
                        <p class="mt-3">
                            Reserve train tickets with ease. Check availability,
                            select class and enjoy smooth railway journeys.
                        </p>
                        <a href="#" class="btn btn-success mt-3">Book Train Ticket</a>
                    </div>
                </div>
            </div>


            <div class="col-md-4 mb-4">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h3>✈ Flight Ticket</h3>
                        <p class="mt-3">
                            Book domestic and international flights at best prices.
                            Fast, secure and convenient air travel booking.
                        </p>
                        <a href="#" class="btn btn-danger mt-3">Book Flight Ticket</a>
                    </div>
                </div>
            </div>

        </div>
    </div>


</main>